# ── Supabase ─────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── Firebase Cloud Messaging ──────────────────────────────────────────────────
# Leave these unset to use the MockNotificationProvider in development.
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@your-project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# ── OpenAI ────────────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-proj-your-key-here

# ── Rate Limiting ─────────────────────────────────────────────────────────────
# Maximum guest requests per minute per IP address (default: 10).
GUEST_REQUEST_RATE_LIMIT=10

# Maximum test notification sends per minute per IP address (default: 5).
TEST_NOTIFICATION_RATE_LIMIT=5

# ── Device Token Cleanup ──────────────────────────────────────────────────────
# How many days of inactivity before a device token is considered stale (default: 30).
DEVICE_INACTIVE_DAYS_THRESHOLD=30

# Maximum number of stale device tokens revoked per cleanup run (default: 100).
DEVICE_CLEANUP_BATCH_SIZE=100

# ── Notification Worker Retry Policy ─────────────────────────────────────────
# Maximum number of retry attempts for transient FCM failures (default: 3).
FCM_MAX_RETRIES=3

# Base delay in milliseconds for exponential backoff (default: 500).
FCM_RETRY_BASE_DELAY_MS=500

# Maximum backoff delay in milliseconds (default: 30000).
FCM_RETRY_MAX_DELAY_MS=30000
